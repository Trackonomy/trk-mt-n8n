# Service PORT
N8N_PORT=5678

# To enable postgress as default DB
DB_TYPE=postgresdb
DB_POSTGRESDB_DATABASE=n8n-db
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_PASSWORD=postgres
DB_POSTGRESDB_USER=postgres
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_POOL_SIZE=2
DB_POSTGRESDB_IDLE_CONNECTION_TIMEOUT=30_000
DB_PING_INTERVAL_SECONDS=2

# Deployment envs
N8N_DEPLOYMENT_TYPE='cloud' # 'default'
N8N_PAYLOAD_SIZE_MAX=16 #MB
N8N_FORMDATA_FILE_SIZE_MAX=200 #MB


# Analytics
N8N_DIAGNOSTICS_POSTHOG_API_KEY=""
N8N_DIAGNOSTICS_POSTHOG_API_HOST="#"
N8N_DIAGNOSTICS_ENABLED=false
N8N_DIAGNOSTICS_CONFIG_FRONTEND=';#'
N8N_DIAGNOSTICS_CONFIG_BACKEND=';#'

# Licence deactivate
N8N_LICENSE_SERVER_URL="#"
N8N_LICENSE_AUTO_RENEW_ENABLED=false
N8N_LICENSE_ACTIVATION_KEY=""
N8N_LICENSE_DETACH_FLOATING_ON_SHUTDOWN=true
N8N_LICENSE_TENANT_ID=1
N8N_LICENSE_CERT=""

# Execution data deletion config
EXECUTIONS_DATA_PRUNE_SOFT_DELETE_INTERVAL=60 #minutes
EXECUTIONS_DATA_PRUNE_HARD_DELETE_INTERVAL=15 #minutes
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336 # Hr
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10_000
EXECUTIONS_DATA_HARD_DELETE_BUFFER=1
N8N_WORKFLOW_HISTORY_ENABLED=true
N8N_WORKFLOW_HISTORY_PRUNE_TIME=168 #hr

# Logs management
N8N_LOG_FILE_COUNT_MAX=90d #Days
N8N_LOG_FILE_SIZE_MAX=16 #MB
N8N_LOG_FILE_LOCATION='logs/n8n.log'

# Timezone
GENERIC_TIMEZONE='America/New_York'
N8N_RELEASE_TYPE='dev' #'stable', 'beta', 'nightly', 'dev'
N8N_GRACEFUL_SHUTDOWN_TIMEOUT=30 #seconds

# Health Check
N8N_RUNNERS_HEALTH_CHECK_SERVER_ENABLED=false
N8N_RUNNERS_HEALTH_CHECK_SERVER_HOST='127.0.0.1'
N8N_RUNNERS_HEALTH_CHECK_SERVER_PORT=5681

# For TRK
N8N_HIRING_BANNER_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENDPOINT='#'
N8N_VERSION_NOTIFICATIONS_WHATS_NEW_ENABLED=false
N8N_VERSION_NOTIFICATIONS_WHATS_NEW_ENDPOINT='#'
N8N_VERSION_NOTIFICATIONS_INFO_URL='#'
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
